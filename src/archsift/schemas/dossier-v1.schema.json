{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archsift.dev/schemas/dossier-v1.schema.json",
  "title": "ArchSift dossier version 1",
  "description": "Case identity, task boundary, problem-value contract, and typed evidence ledger for an architecture decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case"
  ],
  "properties": {
    "schema_version": {
      "description": "ArchSift dossier schema version.",
      "const": 1
    },
    "case": {
      "description": "Human-editable identity for this architecture decision case.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "description": "Stable local identifier for the case.",
          "type": "string",
          "minLength": 1
        },
        "title": {
          "description": "Human-readable case title.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "task": {
      "description": "Operational task and action boundary under architecture review.",
      "$ref": "#/$defs/taskBoundary"
    },
    "problem_value": {
      "description": "Business-value prerequisites for later architecture assessment.",
      "$ref": "#/$defs/problemValue"
    },
    "evidence": {
      "description": "Material claims classified by evidence state.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceEntry"
      }
    }
  },
  "$defs": {
    "taskBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "starts_when",
        "completes_when",
        "accountable_owner",
        "actors",
        "systems_and_tools",
        "information_read",
        "actions",
        "exclusions"
      ],
      "properties": {
        "operation": {
          "description": "One bounded operational task, phrased as an action.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "starts_when": {
          "description": "Observable condition that starts this task.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "completes_when": {
          "description": "Observable condition that completes this task.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "accountable_owner": {
          "description": "Person or role accountable for the task outcome.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "actors": {
          "description": "People, roles, or systems participating in the task.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "systems_and_tools": {
          "description": "Systems and tools involved; an empty array explicitly records none.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "information_read": {
          "description": "Information consumed; an empty array explicitly records none.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "actions": {
          "description": "Outputs or effects produced by the task.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/taskAction"
          }
        },
        "exclusions": {
          "description": "Related work explicitly outside this decision boundary.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "taskAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "consequential",
        "approval_boundary"
      ],
      "properties": {
        "id": {
          "description": "Stable identifier for this produced action.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "description": "Output or effect produced by the task.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "consequential": {
          "description": "Whether an error could materially affect people, rights, money, safety, or operations.",
          "type": "boolean"
        },
        "approval_boundary": {
          "description": "Who may approve or release this action, and at what point.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "problemValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcomes",
        "baselines",
        "constraints",
        "affected_volume",
        "material_pain",
        "error_cost",
        "technology_limitation"
      ],
      "properties": {
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/problemOutcome" }
        },
        "baselines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/problemBaseline" }
        },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/problemConstraint" }
        },
        "affected_volume": { "$ref": "#/$defs/evidencedStatement" },
        "material_pain": { "$ref": "#/$defs/evidencedStatement" },
        "error_cost": { "$ref": "#/$defs/evidencedStatement" },
        "technology_limitation": { "$ref": "#/$defs/evidencedStatement" }
      }
    },
    "problemOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "measure",
        "target",
        "baseline_id",
        "binding",
        "evidence_ids"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankString" },
        "description": { "$ref": "#/$defs/nonBlankString" },
        "measure": { "$ref": "#/$defs/nonBlankString" },
        "target": { "$ref": "#/$defs/nonBlankString" },
        "baseline_id": { "$ref": "#/$defs/nonBlankString" },
        "binding": { "type": "boolean" },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "problemBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "measure", "value", "evidence_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankString" },
        "description": { "$ref": "#/$defs/nonBlankString" },
        "measure": { "$ref": "#/$defs/nonBlankString" },
        "value": { "$ref": "#/$defs/nonBlankString" },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "problemConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "test",
        "required_result",
        "binding",
        "evidence_ids"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankString" },
        "description": { "$ref": "#/$defs/nonBlankString" },
        "test": { "$ref": "#/$defs/nonBlankString" },
        "required_result": { "$ref": "#/$defs/nonBlankString" },
        "binding": { "type": "boolean" },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "evidencedStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidence_ids"],
      "properties": {
        "statement": { "$ref": "#/$defs/nonBlankString" },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonBlankString" }
    },
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "decisionArea": {
      "type": "string",
      "enum": [
        "problem-value",
        "agency-necessity",
        "autonomy-permission",
        "comparative-fit"
      ]
    },
    "evidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "claim",
        "owner",
        "affects"
      ],
      "properties": {
        "id": {
          "description": "Stable identifier used by decision findings.",
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "observed",
            "assumption",
            "estimate",
            "missing"
          ]
        },
        "claim": {
          "description": "The material fact, belief, forecast, or known gap.",
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "description": "Person or role accountable for this entry.",
          "type": "string",
          "minLength": 1
        },
        "affects": {
          "description": "Decision areas affected by this entry.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/decisionArea"
          }
        },
        "provenance": {
          "description": "Named artefact or measurement supporting an observation.",
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "description": "Observation or retrieval date.",
          "type": "string",
          "format": "date"
        },
        "falsified_by": {
          "description": "Observation that would disprove the assumption.",
          "type": "string",
          "minLength": 1
        },
        "method": {
          "description": "Method used to produce the estimate.",
          "type": "string",
          "minLength": 1
        },
        "resolved_by": {
          "description": "Observation that would resolve the evidence gap.",
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "observed"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "provenance",
              "observed_at"
            ],
            "not": {
              "anyOf": [
                { "required": ["falsified_by"] },
                { "required": ["method"] },
                { "required": ["resolved_by"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "assumption"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "falsified_by"
            ],
            "not": {
              "anyOf": [
                { "required": ["provenance"] },
                { "required": ["observed_at"] },
                { "required": ["method"] },
                { "required": ["resolved_by"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "estimate"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "method"
            ],
            "not": {
              "anyOf": [
                { "required": ["provenance"] },
                { "required": ["observed_at"] },
                { "required": ["falsified_by"] },
                { "required": ["resolved_by"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "missing"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "resolved_by"
            ],
            "not": {
              "anyOf": [
                { "required": ["provenance"] },
                { "required": ["observed_at"] },
                { "required": ["falsified_by"] },
                { "required": ["method"] }
              ]
            }
          }
        }
      ]
    }
  }
}
