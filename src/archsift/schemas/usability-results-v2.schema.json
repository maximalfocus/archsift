{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maximalfocus/archsift/schemas/usability-results-v2.schema.json",
  "title": "ArchSift simulated usability results 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "archsift_version_or_commit",
    "overall_result",
    "sessions"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "protocol_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "archsift_version_or_commit": {
      "type": "string",
      "pattern": "^(?:[0-9]+\\.[0-9]+\\.[0-9]+(?:[A-Za-z0-9.+-]*)?|[0-9a-f]{40})(?![\\s\\S])$"
    },
    "overall_result": {
      "enum": ["met", "not-met"]
    },
    "sessions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/session"
      }
    }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "agent_product",
        "agent_model",
        "harness_version",
        "fresh_session",
        "environment",
        "milestones",
        "maintainer_intervention",
        "session_result",
        "failure_reason"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^session-[0-9]{2}$"
        },
        "agent_product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "agent_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "harness_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "fresh_session": {
          "const": true
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operating_system", "python_version", "install_mode"],
          "properties": {
            "operating_system": {
              "enum": ["linux", "macos", "windows"]
            },
            "python_version": {
              "type": "string",
              "pattern": "^3\\.(?:11|12|13|14)(?:\\.[0-9]+)?$"
            },
            "install_mode": {
              "enum": ["source-checkout", "built-wheel"]
            }
          }
        },
        "milestones": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initialize", "complete", "validate", "assess"],
          "properties": {
            "initialize": {
              "enum": ["pass", "fail"]
            },
            "complete": {
              "enum": ["pass", "fail"]
            },
            "validate": {
              "enum": ["pass", "fail"]
            },
            "assess": {
              "enum": ["pass", "fail"]
            }
          }
        },
        "maintainer_intervention": {
          "type": "boolean"
        },
        "session_result": {
          "enum": ["pass", "fail"]
        },
        "failure_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "session_result": {
                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "failure_reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "failure_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
