{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maximalfocus/archsift/schemas/authoring-results-v1.schema.json",
  "title": "ArchSift simulated assisted-authoring results v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "archsift_source_commit",
    "material_set_content_identity",
    "overall_result",
    "sessions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "protocol_version": { "enum": ["1.0.0", "1.0.1", "1.1.0"] },
    "archsift_source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "material_set_content_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "overall_result": { "enum": ["met", "not-met"] },
    "sessions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/session" }
    }
  },
  "$defs": {
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "milestone": { "enum": ["pass", "fail"] },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "agent_product",
        "agent_model",
        "harness_version",
        "fresh_session",
        "environment",
        "milestones",
        "maintainer_intervention",
        "session_result",
        "failure_reason"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^session-[0-9]{2}$"
        },
        "agent_product": { "$ref": "#/$defs/boundedText" },
        "agent_model": { "$ref": "#/$defs/boundedText" },
        "harness_version": { "$ref": "#/$defs/boundedText" },
        "fresh_session": { "const": true },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operating_system", "python_version", "install_mode"],
          "properties": {
            "operating_system": { "enum": ["linux", "macos", "windows"] },
            "python_version": {
              "type": "string",
              "pattern": "^3\\.(?:11|12|13|14)(?:\\.[0-9]+)?$"
            },
            "install_mode": { "enum": ["source-checkout", "built-wheel"] }
          }
        },
        "milestones": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "register_material",
            "inspect_schema",
            "author_dossier",
            "complete_prerequisites",
            "validate",
            "assess"
          ],
          "properties": {
            "register_material": { "$ref": "#/$defs/milestone" },
            "inspect_schema": { "$ref": "#/$defs/milestone" },
            "author_dossier": { "$ref": "#/$defs/milestone" },
            "complete_prerequisites": { "$ref": "#/$defs/milestone" },
            "validate": { "$ref": "#/$defs/milestone" },
            "assess": { "$ref": "#/$defs/milestone" }
          }
        },
        "maintainer_intervention": { "type": "boolean" },
        "session_result": { "enum": ["pass", "fail"] },
        "failure_reason": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "session_result": { "const": "pass" } },
            "required": ["session_result"]
          },
          "then": { "properties": { "failure_reason": { "type": "null" } } },
          "else": {
            "properties": {
              "failure_reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
